# Committed deliberately for this take-home: this is the connection string for
# the local docker-compose database and contains no real secrets. In a real
# project this file would be gitignored and provided via a secret store.
#
# Host port 5433 (not 5432) to avoid colliding with any Postgres already
# installed on the reviewer's machine.
DATABASE_URL="postgresql://workspace:workspace@localhost:5433/workspace"
